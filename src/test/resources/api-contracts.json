{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "health": {"type":"object","required":["status","environment","version"],"properties":{"status":{"const":"UP"},"environment":{"type":"string"},"version":{"type":"string"}}},
    "actuator": {"type":"object","required":["status"],"properties":{"status":{"const":"UP"}}},
    "kpis": {"type":"object","required":["totalHospitais","totalLeitos","totalFontes","totalLeiturasIot","mediaCo2","totalArvores","alertasIot","licencasCriticas"],"properties":{"totalHospitais":{"type":"integer","minimum":0},"totalLeitos":{"type":"integer","minimum":0},"totalFontes":{"type":"integer","minimum":0},"totalLeiturasIot":{"type":"integer","minimum":0},"mediaCo2":{"type":"string"},"totalArvores":{"type":"integer","minimum":0},"alertasIot":{"type":"integer","minimum":0},"licencasCriticas":{"type":"integer","minimum":0}}},
    "status": {"type":"object","required":["status","storage","environment","version","kpis"],"properties":{"status":{"const":"ONLINE"},"storage":{"type":"string"},"environment":{"type":"string"},"version":{"type":"string"},"kpis":{"type":"object","required":["totalHospitais","totalLeiturasIot"]}}},
    "identity": {"type":"object","required":["id","role"],"properties":{"id":{"type":"string","minLength":1},"role":{"enum":["OPERATOR","REVIEWER","ADMIN","LEGACY"]}}},
    "insights": {"type":"object","required":["totalLeituras","conformes","taxaConformidadePct","fontesPrioritarias","metodologia"],"properties":{"totalLeituras":{"type":"integer"},"conformes":{"type":"integer"},"taxaConformidadePct":{"type":"number"},"fontesPrioritarias":{"type":"array"},"metodologia":{"type":"string","minLength":1}}},
    "collection": {"type":"object","required":["collection","total","data"],"properties":{"collection":{"type":"string"},"total":{"type":"integer","minimum":0},"data":{"type":"array"}}},
    "preset": {"type":"object","required":["queryId","descricao","mongoQuery","total","results"],"properties":{"queryId":{"type":"string"},"descricao":{"type":"string"},"mongoQuery":{"type":"string"},"total":{"type":"integer"},"results":{"type":"array"}}},
    "telemetry": {"type":"object","required":["mensagem","leitura","kpisAtualizados"],"properties":{"mensagem":{"type":"string"},"leitura":{"type":"object","required":["codigo_fonte","medicoes","status_conformidade"]},"kpisAtualizados":{"type":"object","required":["totalLeiturasIot"]}}},
    "reset": {"type":"object","required":["mensagem","kpis"],"properties":{"mensagem":{"type":"string"},"kpis":{"type":"object","required":["totalLeiturasIot"]}}},
    "testRunner": {"type":"object","required":["status","output"],"properties":{"status":{"enum":["OK","ERROR"]},"output":{"type":"string","minLength":1}}},
    "operations": {"type":"object","required":["asOf","priorities","monitoredSources","totalSources","staleSources","methodology"],"properties":{"asOf":{"type":"string"},"priorities":{"type":"array"},"monitoredSources":{"type":"integer"},"totalSources":{"type":"integer"},"staleSources":{"type":"integer"},"methodology":{"type":"string"}}},
    "array": {"type":"array"},
    "factor": {"type":"object","required":["id","name","scope","value","source","version","status","createdBy"],"properties":{"id":{"type":"string"},"name":{"type":"string"},"scope":{"enum":["1","2","3"]},"value":{"type":"number"},"source":{"type":"string"},"version":{"type":"string"},"status":{"enum":["DECLARADO_NAO_REVISADO","REVISADO_INTERNAMENTE","REJEITADO"]},"createdBy":{"type":"string"}}},
    "inventory": {"type":"object","required":["id","unit","reference","period","scope","quantity","factor","kgCO2e","dataOrigin","verification"],"properties":{"id":{"type":"string"},"unit":{"type":"string"},"reference":{"type":"string"},"period":{"type":"string"},"scope":{"enum":["1","2","3"]},"quantity":{"type":"number","exclusiveMinimum":0},"factor":{"type":"number"},"kgCO2e":{"type":"number"},"dataOrigin":{"enum":["DECLARED","SIMULATED"]},"verification":{"enum":["DECLARADO_NAO_VERIFICADO","SIMULADO_NAO_VERIFICADO"]}}},
    "waste": {"type":"object","required":["id","unit","reference","group","kg","currentStage","events","verification"],"properties":{"id":{"type":"string"},"unit":{"type":"string"},"reference":{"type":"string"},"group":{"enum":["A","B","C","D","E"]},"kg":{"type":"number","exclusiveMinimum":0},"currentStage":{"enum":["GERADO","SEGREGADO","COLETADO","TRATADO","DESTINADO"]},"events":{"type":"array","minItems":1},"verification":{"type":"string"}}},
    "action": {"type":"object","required":["id","title","unit","owner","due","status","history","createdBy"],"properties":{"id":{"type":"string"},"title":{"type":"string"},"unit":{"type":"string"},"owner":{"type":"string"},"due":{"type":"string"},"status":{"enum":["PLANEJADA","EM_ANDAMENTO","CONCLUIDA"]},"history":{"type":"array","minItems":1},"createdBy":{"type":"string"}}},
    "problem": {"type":"object","required":["type","title","status","detail","instance"],"properties":{"type":{"type":"string"},"title":{"type":"string"},"status":{"type":"integer","minimum":400},"detail":{"type":"string","minLength":1},"instance":{"type":"string","pattern":"^/"}}}
  }
}
