# Copie para .env. Gere os segredos localmente com scripts/init-local-secrets.ps1.
COMPOSE_PROJECT_NAME=ecohospital-local
APP_ENV=local
APP_PORT=8080
BIND_ADDRESS=127.0.0.1
IMAGE=ecohospital:local
APP_VERSION=development
