{
  "name": "esgfinal",
  "networks": {
    "esg-network": {
      "name": "esgfinal_esg-network",
      "driver": "bridge",
      "ipam": {}
    }
  },
  "services": {
    "app": {
      "build": {
        "context": "C:\\Users\\kalicon\\Documents\\Kalicon Programação\\ESG FInal",
        "dockerfile": "Dockerfile",
        "args": {
          "APP_VERSION": "development"
        }
      },
      "cap_drop": [
        "ALL"
      ],
      "command": null,
      "entrypoint": null,
      "environment": {
        "APP_ENV": "local",
        "PORT": "8080",
        "STORAGE_FILE": "/app/data/state.json"
      },
      "image": "ecohospital:local",
      "mem_limit": "536870912",
      "networks": {
        "esg-network": null
      },
      "ports": [
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 8080,
          "published": "8080",
          "protocol": "tcp"
        }
      ],
      "read_only": true,
      "restart": "unless-stopped",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "stop_grace_period": "30s",
      "tmpfs": [
        "/tmp:uid=10001,gid=10001,mode=1770"
      ],
      "volumes": [
        {
          "type": "volume",
          "source": "esg-data",
          "target": "/app/data",
          "volume": {}
        }
      ]
    }
  },
  "volumes": {
    "esg-data": {
      "name": "esgfinal_esg-data"
    }
  }
}
